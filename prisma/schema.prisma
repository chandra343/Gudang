// Multi-Tenant Inventory & Stock Management Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Perusahaan / Tenant
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  address   String?
  plan      String   @default("FREE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  warehouses        Warehouse[]
  categories        Category[]
  products          Product[]
  inventoryStocks   InventoryStock[]
  stockTransactions StockTransaction[]
  suppliers         Supplier[]
  customers         Customer[]
  notes             Note[]
  purchaseOrders      PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
}

// 2. Akun Pengguna & Hak Akses (Login ID Card Karyawan)
model User {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  idCard    String   @unique // Nomor ID Card Karyawan yang diberikan perusahaan
  name      String
  email     String?
  password  String?  @default("")
  role      String   @default("STAFF")
  position  String?  @default("Staf Gudang") // Jabatan karyawan
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 3. Multi-Gudang
model Warehouse {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String
  location    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks       InventoryStock[]
  transactions StockTransaction[]

  @@unique([companyId, code])
}

// 4. Kategori Barang
model Category {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([companyId, name])
}

// 5. Master Barang / Produk (Dengan Gambar & Verifikasi Timestamp)
model Product {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  barcode        String?
  name           String
  description    String?
  unit           String    @default("pcs")
  minStock       Int       @default(5)
  lastInDate     DateTime?
  lastOutDate    DateTime?
  imageUrl       String?   // Foto produk atau bukti
  imageTimestamp String?   // Tanggal, Jam, Menit, Detik terdeteksi
  
  // Informasi Tempat Pembelian / Asal Pengadaan Produk
  supplierName    String?  // Nama perusahaan atau retail di mana dibelinya
  supplierPhone   String?  // Nomor handphone
  supplierWhatsapp String? // Nomor WhatsApp
  supplierAddress String?  // Maps atau kolom alamat perusahaan/retail tempat dibeli

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  stocks       InventoryStock[]
  transactions StockTransaction[]
}

// 6. Stok Fisik per Gudang (Inventory Balance)
model InventoryStock {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
}

// 7. Buku Besar / Log Mutasi Transaksi Stok
model StockTransaction {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  type            String    // IN, OUT, ADJUSTMENT, TRANSFER
  quantity        Int       // Jumlah mutasi (positif atau negatif)
  unit            String    @default("pcs")
  date            DateTime  @default(now())
  imageUrl        String?   // Foto bukti surat jalan / barang masuk-keluar
  imageTimestamp  String?   // Timestamp tanggal-jam-menit-detik terverifikasi
  
  // Informasi Perusahaan / Retail Tempat Pembelian (Untuk Transaksi Masuk)
  supplierName    String?   // Nama perusahaan atau retail di mana dibelinya
  supplierPhone   String?   // Nomor handphone
  supplierWhatsapp String?  // Nomor WhatsApp
  supplierAddress String?   // Maps atau kolom alamat perusahaan/retail tempat dibeli

  referenceNumber String?
  notes           String?
  performedBy     String?
  createdAt       DateTime  @default(now())
}

// 8. Pemasok / Supplier
model Supplier {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 9. Pelanggan / Customer
model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 10. Catatan Gudang / Internal Memo
model Note {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   @default("Operasional") // Operasional, Penting, Supplier, Shift, Umum
  priority  String   @default("NORMAL")      // NORMAL, HIGH, URGENT
  author    String   @default("Staf Gudang")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 11. Purchase Order (PO) dari Sistem Purchasing (Integrasi Pengadaan)
model PurchaseOrder {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  poNumber        String    @unique // Nomor Surat Pesanan, misal: PO-2026-001
  supplierName    String    // Vendor / Pemasok
  supplierPhone   String?
  supplierAddress String?
  status          String    @default("PENDING") // PENDING, APPROVED, SHIPPED, RECEIVED, CANCELLED
  itemsJson       String    // JSON: [{ productId, productName, quantity, unit, price }]
  notes           String?
  orderDate       DateTime  @default(now())
  expectedDate    DateTime?
  receivedAt      DateTime?
  receivedBy      String?   // Nama staf penerima gudang
  receivedWarehouse String? // Nama gudang penerima (misal: Gudang Utama Jakarta)
  receiptNotes    String?   // Catatan fisik kedatangan barang
  receiptPhotoUrl String?   // Foto bukti fisik barang / surat jalan
  receiptTimestamp String?  // Timestamp jam/menit foto
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// 12. Purchase Requisition (PR) / Permintaan Pengadaan dari Gudang ke Purchasing
model PurchaseRequisition {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prNumber    String   @unique // Nomor Permintaan, misal: PR-2026-001
  status      String   @default("SUBMITTED") // SUBMITTED, IN_REVIEW, APPROVED, PO_CREATED, REJECTED
  requestedBy String   // Staf gudang pemohon
  urgency     String   @default("NORMAL")    // NORMAL, URGENT, CRITICAL
  itemsJson   String   // JSON: [{ productId, productName, currentStock, minStock, requestedQty, unit, reason }]
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
